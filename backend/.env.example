# Use: .venv/bin/python scripts/init_local_env.py (from the project root).
# This example contains placeholders only. Never commit backend/.env.
DOTA_DOCS_ENABLED=true
# Explicit local browser QA only; requires a loopback PostgreSQL URL and loopback CORS origins.
# DOTA_LOCAL_ALPHA=true
POSTGRES_USER=dota_hub
POSTGRES_DB=dota_hub
POSTGRES_PASSWORD=<generate-locally>
DATABASE_URL=postgresql+asyncpg://dota_hub:<url-encoded-password>@127.0.0.1:55432/dota_hub
TEST_DATABASE_URL=postgresql+asyncpg://dota_hub:<url-encoded-password>@127.0.0.1:55432/dota_hub_test
MIGRATION_TEST_DATABASE_URL=postgresql+asyncpg://dota_hub:<url-encoded-password>@127.0.0.1:55432/dota_hub_migration_test
DOTA_DB_HEALTH_TIMEOUT_SECONDS=3

# Auth stays unavailable (503) until both secrets are configured locally.
# BOT_TOKEN=<token-of-your-Dota-Hub-bot>
# BOT_USERNAME=<without-leading-at-sign>
# SESSION_SECRET=<independent-cryptographically-random-secret-at-least-32-bytes>
# Empty is fail-closed: /match is denied in every group until exact negative chat IDs are listed.
TELEGRAM_ALLOWED_CHAT_IDS=[]
DOTA_TELEGRAM_MATCH_COOLDOWN_SECONDS=10
# Optional; unauthenticated OpenDota access is supported with lower limits.
# OPEN_DOTA_API_KEY=<optional-key>
DOTA_OPEN_DOTA_TIMEOUT_SECONDS=15
DOTA_OPEN_DOTA_MAX_RETRIES=2
DOTA_OPEN_DOTA_RETRY_BACKOFF_SECONDS=0.25
DOTA_OPEN_DOTA_CACHE_TTL_SECONDS=3600
DOTA_OPEN_DOTA_ERROR_CACHE_TTL_SECONDS=60
DOTA_OPEN_DOTA_NOT_FOUND_CACHE_TTL_SECONDS=300
DOTA_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
DOTA_TELEGRAM_CLOCK_SKEW_SECONDS=30
DOTA_SESSION_TTL_SECONDS=900
# Add only the exact trusted HTTPS origin when deploying; never use a wildcard.
DOTA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
